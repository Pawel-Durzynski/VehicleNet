<Project>
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Pawel Durzynski</Authors>
    <Company>VehicleNet</Company>
    <Copyright>Copyright © 2026 Pawel Durzynski</Copyright>

    <PackageTags>vehicle;vin;car;automotive;dotnet;catalog;validation</PackageTags>
    <PackageProjectUrl>https://github.com/Pawel-Durzynski/VehicleNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Pawel-Durzynski/VehicleNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>../README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>