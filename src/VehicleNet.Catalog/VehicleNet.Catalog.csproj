<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	<PackageId>VehicleNet.Catalog</PackageId>
	<Version>1.0.0</Version>
	<Product>VehicleNet.Catalog</Product>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\VehicleNet.Common\VehicleNet.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\manufacturers.json" />
		<EmbeddedResource Include="Data\models.json" />
		<EmbeddedResource Include="Data\generations.json" />
		<EmbeddedResource Include="Data\versions.json" />
		<EmbeddedResource Include="Data\engines.json" />
		<EmbeddedResource Include="Data\vehicle-bodies.json" />
		<EmbeddedResource Include="Data\vehicle-specs.json" />
	</ItemGroup>

</Project>
